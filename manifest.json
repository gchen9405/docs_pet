{
  "manifest_version": 3,
  "name": "Docs Pet",
  "version": "0.2.0",
  "description": "A pixel cat that keeps you company in Google Docs: it runs while you type, sits when you pause, and sleeps when you idle.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Docs Pet — pick your cat",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["src/content-loader.js"],
      "css": ["src/pet.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/*.js",
        "assets/cat/cat-Sheet.png",
        "assets/popshop-cats/*.png"
      ],
      "matches": ["https://docs.google.com/*"]
    }
  ]
}
